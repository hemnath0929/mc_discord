# ===============================================
# SHADOW PEAKES CONFIGURATION
# ===============================================

# Discord Webhook URL (Get this from your Discord Server -> Channel Settings -> Integrations -> Webhooks)
# Example: https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz_123456
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord Server Invite Link (The link players will click to join after submitting details)
DISCORD_INVITE_URL=https://discord.gg/shadowpeakes
